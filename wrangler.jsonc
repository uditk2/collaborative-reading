{
  "name": "ramayana-reading",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/manifest.webmanifest"]
  },
  // No ids needed: `wrangler deploy` creates these two free resources for you.
  "d1_databases": [{ "binding": "DB" }],
  "kv_namespaces": [{ "binding": "PHOTOS" }]
}
